{
  "name": "webhook-relay",
  "version": "1.0.0",
  "private": true,
  "description": "API NestJS com persist\u00eancia e cen\u00e1rios de falha verific\u00e1veis",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "setup": "node scripts/setup.cjs",
    "demo": "node --env-file=.env scripts/demo.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0"
  }
}
